{
  "name": "mattebox-player-editor",
  "version": "0.0.0",
  "description": "An online editor for the look of <mattebox-player>: a stylesheet, the markup, and a live preview.",
  "private": true,
  "author": "Josep Boix Requesens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/mattebox-player-editor.git"
  },
  "homepage": "https://github.com/jboix/mattebox-player-editor#readme",
  "bugs": {
    "url": "https://github.com/jboix/mattebox-player-editor/issues"
  },
  "license": "MIT",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "verify": "npm run lint && npm run docs:check && npm run typecheck && npm run depcruise && npm run knip && npm run build && npm run test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src",
    "knip": "knip",
    "test": "vitest run",
    "test:node": "vitest run --project=node",
    "test:dom": "vitest run --project=dom",
    "docs:check": "remark . --quiet --frail --use ./scripts/remark-check-formatted.mjs",
    "docs:format": "remark . --quiet --output"
  },
  "dependencies": {
    "@mattebox/player": "^0.5.0",
    "@mattebox/player-diagnostics": "^0.3.0",
    "mattebox": "^0.6.0",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.37.0",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
